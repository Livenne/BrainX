# brainx local development defaults.
# Copy this file to .env for local development. Never commit real secrets.

BRAINX_SERVER_URL=http://localhost:8080
# Leave blank to use the host name detected by the client.
BRAINX_DEVICE_NAME=
BRAINX_POLL_INTERVAL_MS=1000

# Optional local compose database defaults.
POSTGRES_DB=brainx
POSTGRES_USER=brainx
POSTGRES_PASSWORD=replace-with-local-password

# Model and tool provider credentials. Prefer env: references in ~/.brainx/config.json.
NVIDIA_API_KEY=replace-with-your-nvidia-api-key
SHANGAN_API_KEY=replace-with-your-openai-compatible-api-key
TAVILY_API_KEY=replace-with-your-tavily-api-key
